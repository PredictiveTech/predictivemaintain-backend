# Copy this file to .env and fill in the values. .env is ignored by Git: NEVER commit it.
DATABASE_NAME=predictivemaintain
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-change-me

# Origins allowed to call the API from a browser (the mobile apps do not need CORS)
CORS_ALLOWED_ORIGINS=*

# true writes the password-recovery link in the server log (there is no email channel yet).
# Leave it false; turn it on only for a demo, on purpose, and turn it off afterwards.
PASSWORD_RESET_LOG_LINKS=false